{
  "name": "surf-vikings",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "description": "Hyper-local NorCal surf forecasting PWA — Salt Point to Santa Cruz",
  "scripts": {
    "dev": "vite",
    "build": "npm run icons && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/gen-icons.mjs",
    "screenshots": "node scripts/gen-screenshots.mjs",
    "screenshots:local": "node scripts/gen-screenshots.mjs --local"
  },
  "dependencies": {
    "maplibre-gl": "^5.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.14.2",
    "suncalc": "^1.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/suncalc": "^1.9.2",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.59.1",
    "sharp": "^0.33.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^4.1.6"
  }
}
